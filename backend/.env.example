APP_NAME=KosKita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koskita
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verifikasi email (registrasi) butuh mailer sungguhan supaya link verifikasi
# benar-benar terkirim. Untuk pakai Gmail SMTP: aktifkan 2FA di akun Gmail,
# buat "App Password" di myaccount.google.com/apppasswords, lalu isi:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=alamatgmailkamu@gmail.com
#   MAIL_PASSWORD=app-password-16-karakter (tanpa spasi)
#   MAIL_SCHEME= (kosongkan -- port 587 otomatis pakai STARTTLS)
# Selama masih "log", email verifikasi tidak benar-benar terkirim -- cuma
# ditulis ke storage/logs/laravel.log (aman untuk development).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# "Masuk dengan Google" -- lihat catatan lengkap di .env untuk cara isi
# lewat Google Cloud Console. Kosong = tombol tetap ada tapi kasih pesan
# error yang jelas, bukan crash. Client ID Web yang sama dipakai ulang
# untuk mobile (google_sign_in) lewat GET /api/auth/google/config -- lihat
# .env untuk 2 langkah setup tambahan (client ID Android/iOS) yang perlu
# dibuat terpisah di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Platform (Places API New / Geocoding / Distance Matrix) --
# dipakai untuk riset data akomodasi di sekitar wilayah studi kasus skripsi
# (lihat `php artisan places:search-lodging`), bukan dipanggil dari alur
# aplikasi produksi. Buat di Google Cloud Console > APIs & Services >
# Credentials, aktifkan "Places API (New)" di API Library dulu (nama
# produknya persis "Places API (New)", beda dari "Places API" versi lama),
# lalu batasi key ke API tsb + IP server supaya aman kalau bocor. KOSONG
# SENGAJA -- command di atas akan menolak jalan tanpa ini.
GOOGLE_MAPS_API_KEY=

# Chat/notifikasi real-time -- self-hosted (Laravel Reverb), TIDAK butuh
# akun pihak ketiga. Nilai REVERB_APP_ID/KEY/SECRET digenerate otomatis
# saat `php artisan reverb:install`, sudah terisi asli di .env project
# ini (bukan placeholder). PENTING: server Reverb harus jalan TERUS
# (`php artisan reverb:start`) supaya fitur real-time-nya benar-benar
# aktif -- kalau tidak dijalankan, chat/notifikasi tetap berfungsi normal
# lewat polling seperti biasa, cuma tidak instan.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Push notification asli (Firebase Cloud Messaging) -- lihat catatan
# lengkap cara isi di .env (Firebase Console > Project settings > Service
# accounts > Generate new private key). Kosong = FcmService::configured()
# balas false, push di-skip diam-diam, notifikasi tetap terkirim lewat
# email seperti biasa.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Crash/error monitoring (Sentry) -- lihat catatan lengkap cara isi di
# .env (Sentry.io > Create Project > Laravel). Kosong = SDK no-op aman,
# tidak ada yang dikirim/error.
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
